<% layout('layouts/boilerplate') %>

<div class="property-form-wrapper">
  <div class="property-form-card">
    <div class="form-header">
      <span class="auth-badge"><i class="fa-solid fa-house-chimney"></i> Host Portal</span>
      <h1>Publish a New Vacation Stay</h1>
      <p>Fill in the details below to publish your property on StayVerse's global geospatial map.</p>
    </div>

    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
      <div class="alert alert-danger" role="alert">
        <div class="alert-content">
          <i class="fa-solid fa-triangle-exclamation alert-icon"></i>
          <span><%= errorMsg %></span>
        </div>
      </div>
    <% } %>

    <form action="/properties" method="POST" enctype="multipart/form-data" class="property-form" novalidate>
      <!-- Title -->
      <div class="form-group">
        <label for="title" class="form-label">Property Title *</label>
        <input 
          type="text" 
          name="title" 
          id="title" 
          class="form-control-plain" 
          placeholder="e.g. Modern Cliffside Villa with Ocean View" 
          value="<%= typeof property !== 'undefined' && property && property.title ? property.title : '' %>"
          required
        >
      </div>

      <!-- Description -->
      <div class="form-group">
        <label for="description" class="form-label">Description *</label>
        <textarea 
          name="description" 
          id="description" 
          rows="5" 
          class="form-control-plain" 
          placeholder="Describe what makes your space unique, comfortable, and memorable..." 
          required
        ><%= typeof property !== 'undefined' && property && property.description ? property.description : '' %></textarea>
      </div>

      <!-- Price -->
      <div class="form-group">
        <label for="pricePerNight" class="form-label">Price per Night (USD) *</label>
        <div class="input-currency-wrap">
          <span class="currency-prefix">$</span>
          <input 
            type="number" 
            name="pricePerNight" 
            id="pricePerNight" 
            class="form-control-plain with-prefix" 
            placeholder="195" 
            min="1"
            value="<%= typeof property !== 'undefined' && property && property.pricePerNight ? property.pricePerNight : '' %>"
            required
          >
        </div>
      </div>

      <div class="form-row-3">
        <!-- Address -->
        <div class="form-group">
          <label for="address" class="form-label">Street Address *</label>
          <input 
            type="text" 
            name="address" 
            id="address" 
            class="form-control-plain" 
            placeholder="124 Coastline Blvd" 
            value="<%= typeof property !== 'undefined' && property && property.address ? property.address : '' %>"
            required
          >
        </div>

        <!-- City -->
        <div class="form-group">
          <label for="city" class="form-label">City *</label>
          <input 
            type="text" 
            name="city" 
            id="city" 
            class="form-control-plain" 
            placeholder="Malibu" 
            value="<%= typeof property !== 'undefined' && property && property.city ? property.city : '' %>"
            required
          >
        </div>

        <!-- Country -->
        <div class="form-group">
          <label for="country" class="form-label">Country *</label>
          <input 
            type="text" 
            name="country" 
            id="country" 
            class="form-control-plain" 
            placeholder="United States" 
            value="<%= typeof property !== 'undefined' && property && property.country ? property.country : '' %>"
            required
          >
        </div>
      </div>

      <!-- Geospatial Coordinates -->
      <div class="form-row-2">
        <div class="form-group">
          <label for="latitude" class="form-label">Latitude (-90 to 90) *</label>
          <input 
            type="number" 
            step="any" 
            name="latitude" 
            id="latitude" 
            class="form-control-plain" 
            placeholder="34.0259"
            value="<%= typeof property !== 'undefined' && property && property.location && property.location.coordinates ? property.location.coordinates[1] : (typeof property !== 'undefined' && property && property.latitude ? property.latitude : '34.0259') %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="longitude" class="form-label">Longitude (-180 to 180) *</label>
          <input 
            type="number" 
            step="any" 
            name="longitude" 
            id="longitude" 
            class="form-control-plain" 
            placeholder="-118.7798"
            value="<%= typeof property !== 'undefined' && property && property.location && property.location.coordinates ? property.location.coordinates[0] : (typeof property !== 'undefined' && property && property.longitude ? property.longitude : '-118.7798') %>"
            required
          >
        </div>
      </div>

      <!-- Amenities Checklist -->
      <div class="form-group">
        <label class="form-label">Select Amenities</label>
        <div class="amenities-checklist">
          <% const allAmenities = ['WiFi', 'Pool', 'Free Parking', 'Kitchen', 'Air Conditioning', 'Hot Tub', 'Dedicated Workspace', 'Beach Access', 'Mountain View', 'Pet Friendly']; %>
          <% allAmenities.forEach(am => { %>
            <label class="amenity-checkbox-label">
              <input type="checkbox" name="amenities" value="<%= am %>">
              <span><%= am %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <!-- Multiple Images Upload -->
      <div class="form-group">
        <label for="images" class="form-label">Property Photos (Up to 5 images)</label>
        <div class="file-upload-box">
          <i class="fa-solid fa-cloud-arrow-up file-icon"></i>
          <p>Drag and drop photos here, or click to browse</p>
          <span class="file-support-text">JPEG, PNG, WEBP (Max 5MB each)</span>
          <input type="file" name="images" id="images" class="file-input-hidden" multiple accept="image/*">
        </div>
      </div>

      <div class="form-actions-row">
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="fa-solid fa-paper-plane"></i> Publish Listing
        </button>
        <a href="/properties" class="btn btn-outline btn-lg">Cancel</a>
      </div>
    </form>
  </div>
</div>
