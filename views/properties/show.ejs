                  src="<%= (rec.images && rec.images[0] && rec.images[0].url) ? rec.images[0].url : 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80' %>" 
                  alt="<%= rec.title %>"
                  class="property-img"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80';"
                >
                <div class="property-rating-badge">
                  <i class="fa-solid fa-star"></i>
                  <span><%= rec.averageRating > 0 ? rec.averageRating.toFixed(1) : 'New' %></span>
                </div>
              </div>

              <div class="property-card-body">
                <div class="property-card-location">
                  <i class="fa-solid fa-location-dot"></i> <%= rec.city %>, <%= rec.country %>
                </div>
                <h3 class="property-card-title"><%= rec.title %></h3>
                
                <div class="property-card-footer">
                  <div class="property-price">
                    <span class="price-val">&#8377;<%= rec.pricePerNight.toLocaleString('en-IN') %></span>
                    <span class="price-unit">/ <%= rec.priceUnit || 'night' %></span>
                  </div>
                  <span class="btn-card-view">Explore &rarr;</span>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <!-- Stripe Payment Simulation Modal -->
  <div class="stripe-modal-overlay" id="stripeModalOverlay" style="display: none;">
    <div class="stripe-modal-card" id="stripeModalCard">
      <!-- Header -->
      <div class="stripe-modal-header">
        <div class="stripe-brand-wrap">
          <span class="stripe-logo-text"><i class="fa-brands fa-stripe"></i></span>
          <span class="stripe-badge-test"><i class="fa-solid fa-flask"></i> TEST MODE</span>
        </div>
        <button type="button" class="stripe-modal-close" id="btnCloseStripeModal" aria-label="Close modal" title="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Payment Body -->
      <div class="stripe-modal-body" id="stripeModalBody">
        <!-- Summary Box -->
        <div class="stripe-order-summary">
          <div class="stripe-summary-media">
            <img src="<%= (property.images && property.images[0] && property.images[0].url) ? property.images[0].url : mainImageUrl %>" alt="<%= property.title %>" class="stripe-summary-thumb">
          </div>
          <div class="stripe-summary-info">
            <h4 class="stripe-summary-title"><%= property.title %></h4>
            <p class="stripe-summary-dates" id="stripeModalDates">Dates selected</p>
            <div class="stripe-summary-amount" id="stripeModalAmount">&#8377;0</div>
          </div>
        </div>

        <!-- Payment Form Details -->
        <div class="stripe-form-section">
          <div class="stripe-section-title">
            <span>Payment method</span>
            <span class="stripe-secure-tag"><i class="fa-solid fa-shield-halved"></i> 256-bit SSL</span>
          </div>

          <div class="stripe-card-element-box">
            <div class="stripe-input-row card-number-row">
              <label class="stripe-label">CARD NUMBER</label>
              <div class="stripe-card-input-wrap">
                <input type="text" class="stripe-field" id="stripeCardNum" value="4242 •••• •••• 4242" readonly>
                <div class="stripe-card-brands">
                  <i class="fa-brands fa-cc-visa text-primary"></i>
                  <i class="fa-brands fa-cc-mastercard text-warning"></i>
                </div>
              </div>
            </div>

            <div class="stripe-split-row">
              <div class="stripe-input-row">
                <label class="stripe-label">EXPIRES</label>
                <input type="text" class="stripe-field" value="12 / 28" readonly>
              </div>
              <div class="stripe-input-row">
                <label class="stripe-label">CVC</label>
                <input type="text" class="stripe-field" value="123" readonly>
              </div>
            </div>

            <div class="stripe-input-row">
              <label class="stripe-label">CARDHOLDER NAME</label>
              <input type="text" class="stripe-field" id="stripeCardName" value="<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.name) ? currentUser.name : 'Verified Traveler' %>">
            </div>

            <div class="stripe-input-row">
              <label class="stripe-label">COUNTRY OR REGION</label>
              <select class="stripe-field-select">
                <option selected>India</option>
                <option>United States</option>
                <option>United Kingdom</option>
                <option>Singapore</option>
                <option>United Arab Emirates</option>
              </select>
            </div>
          </div>

          <!-- Simulated notice -->
          <div class="stripe-sandbox-notice">
            <i class="fa-solid fa-circle-info"></i>
            <span>This is an interactive Stripe Sandbox simulation. No real money will be charged.</span>
          </div>

          <!-- Pay & Cancel Buttons -->
          <div class="stripe-btn-actions">
            <button type="button" class="btn-stripe-pay" id="btnStripeConfirmPay">
              <span id="btnStripePayContent">
                <i class="fa-solid fa-lock"></i> Authorize &amp; Pay <span id="stripePayBtnAmount">&#8377;0</span>
              </span>
            </button>
            <button type="button" class="btn-stripe-cancel" id="btnCancelStripeModal">
              <i class="fa-solid fa-arrow-left"></i> Cancel &amp; Edit Dates
            </button>
