          <h2 class="recommendations-title">Similar Stays You Might Love</h2>
          <p class="text-muted">Handpicked nearby getaways matching this stay's ambiance, price tier, and guest ratings.</p>
        </div>
      </div>

      <div class="property-grid" style="margin-top: 1.5rem;">
        <% recommendations.forEach(rec => { %>
