<% layout('layouts/boilerplate') %>

<div class="property-detail-wrapper">
  <!-- Top Bar -->
  <div class="property-topbar">
    <a href="/properties" class="back-link">
      <i class="fa-solid fa-arrow-left"></i> All Stays
    </a>
    
    <div class="property-actions">
      <% if (typeof currentUser !== 'undefined' && currentUser && property.host && (currentUser._id.toString() === property.host._id.toString() || currentUser.id === property.host.id)) { %>
        <span class="owner-pill"><i class="fa-solid fa-crown"></i> Your Listing</span>
        <a href="/properties/<%= property._id %>/edit" class="btn btn-outline btn-sm">
          <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
        <form action="/properties/<%= property._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Are you certain you wish to permanently delete this listing?');">
          <button type="submit" class="btn btn-danger-outline btn-sm">
            <i class="fa-solid fa-trash-can"></i> Delete
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Header Info -->
  <div class="property-header">
    <h1 class="property-title"><%= property.title %></h1>
    <div class="property-meta-row">
      <span class="meta-item">
        <i class="fa-solid fa-star text-warning"></i>
        <strong><%= property.averageRating > 0 ? property.averageRating.toFixed(1) : 'New' %></strong>
        <span class="text-muted">(<%= property.reviewCount %> <%= property.reviewCount === 1 ? 'review' : 'reviews' %>)</span>
      </span>
      <span class="meta-separator">•</span>
      <span class="meta-item">
        <i class="fa-solid fa-location-dot"></i> <%= property.address %>, <%= property.city %>, <%= property.country %>
      </span>
    </div>
  </div>

  <!-- Image Showcase -->
  <div class="property-gallery">
    <div class="gallery-main">
      <img 
        src="<%= (property.images && property.images[0] && property.images[0].url) ? property.images[0].url : 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1400&q=80' %>" 
        alt="<%= property.title %>"
        class="img-featured"
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1400&q=80';"
      >
    </div>
    <% if (property.images && property.images.length > 1) { %>
      <div class="gallery-thumbnails">
        <% property.images.slice(1, 5).forEach((img, i) => { %>
          <div class="thumb-wrap">
            <img src="<%= img.url %>" alt="Photo <%= i + 2 %>" class="img-thumb" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=600&q=80';">
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Main Details Content -->
  <div class="property-content-grid">
    <!-- Left Column: Description, Host, Amenities, Map -->
    <div class="property-main-col">
      <!-- Host Profile Ribbon -->
      <div class="host-ribbon">
        <div class="host-avatar">
          <%= property.host && property.host.name ? property.host.name.charAt(0).toUpperCase() : 'H' %>
        </div>
        <div class="host-details">
          <h3>Hosted by <%= property.host ? property.host.name : 'StayVerse Host' %></h3>
          <p class="text-muted">Verified Host • Dedicated to exceptional guest experiences</p>
        </div>
      </div>

      <hr class="section-divider">

      <!-- Description -->
      <div class="property-section">
        <h2>About this space</h2>
        <p class="property-description"><%= property.description %></p>
      </div>

      <hr class="section-divider">

      <!-- Amenities -->
      <div class="property-section">
        <h2>What this place offers</h2>
        <% if (property.amenities && property.amenities.length > 0) { %>
          <div class="amenities-grid">
            <% property.amenities.forEach(item => { %>
              <div class="amenity-item">
                <i class="fa-solid fa-circle-check text-primary"></i>
                <span><%= item %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted">Standard vacation amenities provided.</p>
        <% } %>
      </div>

      <hr class="section-divider">

      <!-- Location Map Section -->
      <div class="property-section">
        <h2>Where you'll be</h2>
        <p class="text-muted"><%= property.address %>, <%= property.city %>, <%= property.country %></p>
        <div 
          id="propertyMap" 
          class="map-container"
          data-lng="<%= property.location.coordinates[0] %>"
          data-lat="<%= property.location.coordinates[1] %>"
          data-title="<%= property.title %>"
          data-address="<%= property.address %>"
          data-city="<%= property.city %>"
        >
          <!-- Fallback placeholder while map loads -->
          <div class="map-placeholder">
            <i class="fa-solid fa-spinner fa-spin"></i>
            <p>Loading interactive MapLibre map...</p>
          </div>
      </div>

      <hr class="section-divider">

      <!-- Guest Reviews & Ratings Section -->
      <div class="property-section reviews-section">
        <div class="reviews-header">
          <div class="reviews-header-left">
            <h2>Guest Reviews & Ratings</h2>
            <div class="reviews-rating-summary">
              <span class="big-rating"><i class="fa-solid fa-star text-warning"></i> <%= property.averageRating > 0 ? property.averageRating.toFixed(1) : 'New' %></span>
              <span class="rating-reviews-count">• <%= property.reviewCount || 0 %> <%= (property.reviewCount === 1) ? 'verified review' : 'verified reviews' %></span>
            </div>
          </div>
        </div>

        <!-- Add Review Form -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="add-review-card">
            <h3>Leave a Review</h3>
            <p class="text-muted">Share your experience to help future guests plan their stay.</p>
            <form action="/properties/<%= property._id %>/reviews" method="POST" class="review-form">
              <div class="form-group">
                <label class="form-label">Your Rating</label>
                <div class="star-rating-selector">
                  <input type="radio" id="star5" name="rating" value="5" checked /><label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                </div>
              </div>

              <div class="form-group">
                <label for="comment" class="form-label">Review Comment</label>
                <textarea 
                  name="comment" 
                  id="comment" 
                  rows="3" 
                  class="form-control-plain" 
                  placeholder="How was your stay? Tell other travelers about the location, amenities, and host..."
                  required
                ></textarea>
              </div>

              <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-paper-plane"></i> Submit Review
              </button>
            </form>
          </div>
        <% } else { %>
          <div class="login-to-review-banner">
            <i class="fa-solid fa-comment-dots"></i>
            <div>
              <strong>Have you stayed here?</strong>
              <p>Please <a href="/auth/login" class="text-primary font-weight-bold">sign in</a> to submit a review and rating.</p>
            </div>
          </div>
        <% } %>

        <!-- Existing Reviews List -->
        <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
          <div class="reviews-list">
            <% reviews.forEach(rev => { %>
              <div class="review-card">
                <div class="review-card-top">
                  <div class="reviewer-info">
                    <div class="reviewer-avatar">
                      <%= rev.user && rev.user.name ? rev.user.name.charAt(0).toUpperCase() : 'G' %>
                    </div>
                    <div>
                      <h4 class="reviewer-name"><%= rev.user ? rev.user.name : 'Verified Traveler' %></h4>
                      <span class="review-date"><%= new Date(rev.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></span>
                    </div>
                  </div>

                  <div class="review-card-right">
                    <div class="review-stars">
                      <% for (let s = 1; s <= 5; s++) { %>
                        <i class="fa-solid fa-star <%= s <= rev.rating ? 'text-warning' : 'text-muted-star' %>"></i>
                      <% } %>
                    </div>

                    <% if (typeof currentUser !== 'undefined' && currentUser && rev.user && (currentUser._id.toString() === rev.user._id.toString() || currentUser.id === rev.user.id)) { %>
                      <form action="/properties/<%= property._id %>/reviews/<%= rev._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Delete this review?');">
                        <button type="submit" class="btn-delete-review" title="Delete Review">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>

                <p class="review-comment"><%= rev.comment %></p>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="no-reviews-box">
            <i class="fa-regular fa-comment-dots"></i>
            <p>No written reviews yet. Be the first guest to review this stay!</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Booking Widget Preview (Prepared for Module 4) -->
    <aside class="property-sidebar">
      <div class="booking-widget-card">
        <div class="widget-price-header">
          <div class="widget-price">
            <span class="price-amount">&#8377;<%= property.pricePerNight.toLocaleString('en-IN') %></span>
            <span class="price-period">/ <%= property.priceUnit || 'night' %></span>
          </div>
          <div class="widget-rating">
            <i class="fa-solid fa-star text-warning"></i>
            <span><%= property.averageRating > 0 ? property.averageRating.toFixed(1) : 'New' %></span>
          </div>
        </div>

        <div class="booking-preview-box">
          <div class="date-picker-placeholder">
            <div class="picker-col">
              <label>CHECK-IN</label>
              <span>Select Date</span>
            </div>
            <div class="picker-col">
              <label>CHECKOUT</label>
              <span>Select Date</span>
            </div>
          </div>

          <a href="/properties" class="btn btn-primary btn-block btn-lg">
            <i class="fa-solid fa-calendar-check"></i> Reserve Dates
          </a>

          <p class="booking-guarantee">
            <i class="fa-solid fa-shield-halved"></i> Concurrency-Safe Instant Confirmation
          </p>
        </div>
      </div>
    </aside>
  </div>
</div>
