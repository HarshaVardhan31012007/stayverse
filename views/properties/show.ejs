        </div>
      </div>

      <!-- Processing / Success Screen -->
      <div class="stripe-modal-success" id="stripeModalSuccess" style="display: none;">
        <div class="stripe-success-icon-wrap">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3>Payment Authorized!</h3>
        <p class="stripe-tx-id" id="stripeTxIdDisplay">Transaction ID: pi_stripe_...</p>
        <div class="stripe-success-status">
          <i class="fa-solid fa-spinner fa-spin"></i> Finalizing reservation with concurrency lock...
        </div>
      </div>

      <div class="stripe-modal-footer">
        <span>Powered by <strong>stripe</strong></span>
        <span><i class="fa-solid fa-shield-halved text-success"></i> 256-bit SSL • PCI Compliant</span>
      </div>
    </div>
  </div>

  <script>
    // Stripe Payment Modal Logic
    (function initStripeSimulation() {
      const btnReserve = document.getElementById('btnReserve');
      const checkIn = document.getElementById('checkIn');
      const checkOut = document.getElementById('checkOut');
      const overlay = document.getElementById('stripeModalOverlay');
      const btnClose = document.getElementById('btnCloseStripeModal');
      const btnCancel = document.getElementById('btnCancelStripeModal');
      const btnConfirmPay = document.getElementById('btnStripeConfirmPay');
      const bookingForm = document.getElementById('bookingForm');

      const closeModal = () => {
        if (overlay) overlay.style.display = 'none';
        document.body.style.overflow = '';
      };

      const openModal = () => {
        if (overlay) overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      };

      if (btnClose) btnClose.addEventListener('click', closeModal);
      if (btnCancel) btnCancel.addEventListener('click', closeModal);

      if (overlay) {
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeModal();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay && overlay.style.display === 'flex') {
          closeModal();
        }
      });

      if (btnReserve) {
        btnReserve.addEventListener('click', (e) => {
          e.preventDefault();
          if (!checkIn || !checkOut || !checkIn.value || !checkOut.value) {
            alert('Please select both Check-in and Checkout dates first.');
            if (checkIn) checkIn.focus();
            return;
          }

          if (typeof window.checkOverlap === 'function') {
            const collided = window.checkOverlap(checkIn.value, checkOut.value);
            if (collided) {
              alert('Selected dates overlap with an existing reservation. Please pick open dates.');
              return;
            }
          }

          const pricePerNight = window.propertyPricePerNight || Number('<%= property.pricePerNight %>') || 0;
          const start = new Date(checkIn.value);
          const end = new Date(checkOut.value);
          const nights = Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24)));
          const subtotal = nights * pricePerNight;
          const gst = Math.round(subtotal * 0.12);
          const serviceFee = Math.round(subtotal * 0.05);
          const grandTotal = subtotal + gst + serviceFee;

          const formattedIn = start.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          const formattedOut = end.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          const guestsCount = document.getElementById('guests')?.value || '1';

          const datesEl = document.getElementById('stripeModalDates');
          if (datesEl) {
            datesEl.textContent = `${formattedIn} → ${formattedOut} (${nights} ${nights === 1 ? 'night' : 'nights'} • ${guestsCount} ${guestsCount === '1' ? 'guest' : 'guests'})`;
          }

          const amountEl = document.getElementById('stripeModalAmount');
          if (amountEl) {
            amountEl.innerHTML = `<div style="font-size:0.78rem;color:#aaa;margin-bottom:2px;">&#8377;${subtotal.toLocaleString('en-IN')} + &#8377;${gst.toLocaleString('en-IN')} GST + &#8377;${serviceFee.toLocaleString('en-IN')} Fee</div><div style="font-size:1.25rem;font-weight:700;">&#8377;${grandTotal.toLocaleString('en-IN')}</div>`;
          }

          const btnAmountEl = document.getElementById('stripePayBtnAmount');
          if (btnAmountEl) btnAmountEl.innerHTML = `&#8377;${grandTotal.toLocaleString('en-IN')}`;

          // Reset modal state
          const bodyEl = document.getElementById('stripeModalBody');
          const successEl = document.getElementById('stripeModalSuccess');
          if (bodyEl) bodyEl.style.display = 'block';
          if (successEl) successEl.style.display = 'none';

          if (btnConfirmPay) {
            btnConfirmPay.disabled = false;
            btnConfirmPay.innerHTML = `<i class="fa-solid fa-lock"></i> Authorize &amp; Pay &#8377;${grandTotal.toLocaleString('en-IN')}`;
          }

          openModal();
        });
      }

      if (btnConfirmPay) {
        btnConfirmPay.addEventListener('click', (e) => {
          e.preventDefault();
          btnConfirmPay.disabled = true;
          btnConfirmPay.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Authorizing with Stripe...';

          setTimeout(() => {
            const txId = 'pi_3' + Math.random().toString(36).substring(2, 9) + Math.random().toString(36).substring(2, 9);
            const txInput = document.getElementById('paymentTransactionId');
            if (txInput) txInput.value = txId;

            const bodyEl = document.getElementById('stripeModalBody');
            const successEl = document.getElementById('stripeModalSuccess');
            const txDisplay = document.getElementById('stripeTxIdDisplay');

            if (bodyEl) bodyEl.style.display = 'none';
            if (successEl) successEl.style.display = 'block';
            if (txDisplay) txDisplay.textContent = 'Stripe Charge ID: ' + txId;

            // Automatically submit booking form after brief confirmation
            setTimeout(() => {
              if (bookingForm) bookingForm.submit();
            }, 1000);
          }, 1200);
        });
      }
    })();
  </script>
</div>

<script>
  // Restore user's active search/GPS filters when returning to explorer
  document.addEventListener('DOMContentLoaded', () => {
    const backLink = document.getElementById('propertyBackLink');
    const backText = document.getElementById('propertyBackLinkText');
    const savedFilterUrl = sessionStorage.getItem('stayverse_filter_url');

    if (savedFilterUrl && backLink) {
      backLink.href = savedFilterUrl;
      if (backText) backText.textContent = 'Back to Filtered Results';
    } else if (document.referrer && document.referrer.includes('/properties')) {
      if (backLink) {
        backLink.addEventListener('click', (e) => {
          e.preventDefault();
          history.back();
        });
      }
    }

    // Photo Lightbox & Gallery Interactions
    const lightboxModal = document.getElementById('photoLightboxModal');
    const lightboxImg = document.getElementById('lightboxModalImg');
    const btnCloseLightbox = document.getElementById('btnCloseLightbox');
    const btnOpenLightbox = document.getElementById('btnOpenLightbox');
    const featuredMainImg = document.getElementById('featuredMainImg');
    const galleryAmbientBg = document.getElementById('galleryAmbientBg');
    const galleryMainSlot = document.getElementById('galleryMainSlot');
    const thumbWraps = document.querySelectorAll('.thumb-wrap');

    const openLightbox = (url) => {
      if (lightboxModal && lightboxImg) {
        lightboxImg.src = url || (featuredMainImg ? featuredMainImg.src : '');
        lightboxModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    };

    const closeLightbox = () => {
      if (lightboxModal) {
        lightboxModal.classList.remove('active');
        document.body.style.overflow = '';
      }
    };

    if (btnOpenLightbox) {
      btnOpenLightbox.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox();
      });
    }

    if (galleryMainSlot) {
      galleryMainSlot.addEventListener('click', () => {
        openLightbox();
      });
    }

    if (btnCloseLightbox) {
      btnCloseLightbox.addEventListener('click', (e) => {
        e.stopPropagation();
        closeLightbox();
      });
    }

    if (lightboxModal) {
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal || e.target.classList.contains('lightbox-content')) {
          closeLightbox();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightboxModal?.classList.contains('active')) {
        closeLightbox();
      }
    });

    // Clicking any thumbnail swaps it into the main featured showcase
    thumbWraps.forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        const newUrl = thumb.getAttribute('data-img-url');
        if (newUrl && featuredMainImg) {
          featuredMainImg.src = newUrl;
          if (galleryAmbientBg) {
            galleryAmbientBg.style.backgroundImage = `url('${newUrl}')`;
          }
          if (lightboxImg) {
            lightboxImg.src = newUrl;
          }
        }
      });
    });
  });
</script>
