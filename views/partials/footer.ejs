<footer class="footer-wrapper">
  <div class="footer-container container">
    <div class="footer-brand-col">
      <div class="footer-logo">
        <span class="brand-icon"><i class="fa-solid fa-compass"></i></span>
        <span class="brand-text">Stay<span class="brand-accent">Verse</span></span>
      </div>
      <p class="footer-tagline">
        Engineered for seamless vacation rentals. Designed with modern architecture, geospatial discovery, and concurrency-safe bookings.
      </p>
      <div class="footer-badges">
        <span class="tech-badge"><i class="fa-brands fa-node-js"></i> Node.js</span>
        <span class="tech-badge"><i class="fa-solid fa-leaf"></i> MongoDB Atlas</span>
        <span class="tech-badge"><i class="fa-solid fa-map-location-dot"></i> MapLibre GL</span>
        <span class="tech-badge"><i class="fa-solid fa-shield-halved"></i> JWT Secured</span>
      </div>
    </div>

    <div class="footer-links-col">
      <h4>Platform</h4>
      <ul>
        <li><a href="/properties">Explore Listings</a></li>
        <li><a href="/properties/nearby">Nearby Search</a></li>
        <% if (!(typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'traveler')) { %>
          <li><a href="/auth/register">Become a Host</a></li>
        <% } %>
      </ul>
    </div>

    <div class="footer-links-col">
      <h4>Architecture</h4>
      <ul>
        <li><span class="text-muted">MVC Pattern</span></li>
        <li><span class="text-muted">2dsphere Geospatial</span></li>
        <li><span class="text-muted">ACID Transactions</span></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <p>&copy; <%= new Date().getFullYear() %> StayVerse Platform. Built for production excellence.</p>
    <div class="footer-status">
      <span class="status-indicator"></span> System Operational
    </div>
  </div>
</footer>
